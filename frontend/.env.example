# 주식 백엔드 (Railway — backend-stock 서비스)
VITE_API_BASE_URL=http://localhost:8000

# 부동산 백엔드 (Railway — backend-realestate 서비스)
# 로컬: Vite proxy가 /api/realestate/* → localhost:8001 로 자동 분기하므로 비워둬도 됨
# Cloudflare Workers 배포: https://fomobot-realestate-production.up.railway.app 형태로 입력
VITE_RE_API_BASE_URL=

# 카카오 AdFit 광고단위 ID — 비워두면 해당 슬롯이 렌더되지 않음 (AdFit 심사 대기 중 안전 배포용)
VITE_ADFIT_UNIT_DESKTOP_BOTTOM=
VITE_ADFIT_UNIT_MOBILE_BOTTOM=

# 앱인토스 배너 광고 그룹 ID. toss 빌드는 vite.config.ts의 값을 쓰며, 다른 ID로 빌드할 때만 여기에 지정한다.
# dev 서버는 값과 무관하게 테스트 ID(ait-ad-test-banner-id)를 쓴다.
VITE_TOSS_BANNER_AD_GROUP_ID=
